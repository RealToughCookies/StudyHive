# Cloud is the default. Copy to .env.local and fill in your project's public settings.
VITE_DATA_MODE=cloud
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# For the existing browser-only demo, use VITE_DATA_MODE=local instead.
# Never place database passwords, service-role/secret keys, payment secrets,
# or an OpenAI API key in VITE_* variables. They are included in browser code.
